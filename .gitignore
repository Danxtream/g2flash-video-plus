# Firmware blobs are not redistributed — build_cfw.sh downloads the stock image
# from Even's CDN and patches it locally.
*.bin

# Python virtualenv created by build_cfw.sh, and bytecode caches.
/venv/
__pycache__/
*.pyc

# Build intermediates (build.py writes .o / .text.bin here).
/obj/
*.o

# Sub0h264 test clips (71 MB, stored with Git LFS upstream) are not committed.
# Fetch tests/fixtures from https://github.com/CraigHutchinson/Sub0h264 at the
# commit named in the vendoring commit message.
/third-party/sub0h264/tests/fixtures/
